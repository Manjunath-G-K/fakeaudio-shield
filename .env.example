# FakeAudio Shield configuration. All settings are optional; no secrets are needed.
# FAKEAUDIO_* are read by the backend from real environment variables (set them in your
# shell, Docker -e or hosting provider; the backend does not load .env files).
# VITE_* are read by the frontend build from a .env file in the repository root.
# Copy this file to .env for local use. Never commit .env.

# Backend: comma-separated browser origins allowed to call the API (CORS).
# Only needed when the website is served from a different origin than the API.
FAKEAUDIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend: folder with the built website (npm run build). Served from / when it exists.
# FAKEAUDIO_FRONTEND_DIST=../frontend/dist

# Frontend (build time): API base URL when the API is on another host. Leave empty when
# the backend serves the website itself (same origin).
VITE_API_BASE=
